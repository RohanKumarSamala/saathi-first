# Used by `npm run dev:test*`: the sites talk to the local Firebase emulators (`npm run emulators`),
# never to the real project. "demo-" project IDs cannot reach any real Google service.
VITE_FIREBASE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-saathi-first
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-saathi-first.firebaseapp.com
VITE_FIREBASE_APP_ID=demo-app
