# Copy this file to .env.local and paste the values from
# Firebase console > Project settings > General > Your apps > Web app > SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Links between the three websites (leave empty while developing locally).
# On the main site: shows "Admin" in the account menu for admins.
VITE_ADMIN_URL=
# On the admin site: the "View site" link.
VITE_MAIN_SITE_URL=
